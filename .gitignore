# ── Ketergantungan ───────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Hasil bangun ─────────────────────────────────────────────────────────────
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# Klien Prisma dibangkitkan dari prisma/schema.prisma lewat `prisma generate`.
# Ia berisi puluhan ribu baris yang berubah setiap kali skema disentuh, dan
# menyimpannya di git membuat setiap diff mustahil dibaca.
/src/generated/prisma

# ── Rahasia ──────────────────────────────────────────────────────────────────
# Seluruh varian .env diabaikan, hanya contohnya yang ikut. Repo ini publik:
# satu berkas .env yang lolos berarti kunci basis data dan kunci model bahasa
# terbaca siapa pun.
.env
.env.*
!.env.example
*.pem
*.key

# ── Berkas pribadi dan berkas lomba ──────────────────────────────────────────
# Memuat NIK, alamat, dan nomor telepon pada surat pernyataan bermaterai.
# TIDAK BOLEH masuk ke repo publik dalam keadaan apa pun.
dokumen-lomba/

# ── Alat dan sistem operasi ──────────────────────────────────────────────────
.vercel
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Konfigurasi perkakas pengembangan ────────────────────────────────────────
# Sekelas .vscode/ atau .idea/ — pengaturan mesin sendiri, bukan bagian karya.
.claude/
.vscode/
.idea/

# ── Panduan agen yang ditulis ulang otomatis oleh `next dev` ─────────────────
AGENTS.md
CLAUDE.md

# Berkas yang dibangkitkan perkakas desain pihak ketiga. Pernah berisi analisis
# desain produk lain yang sama sekali tidak berhubungan dengan aplikasi ini.
DESIGN.md
