# Salin berkas ini menjadi .env lalu isi nilainya.
# .env TIDAK BOLEH masuk ke git (sudah diabaikan lewat .gitignore).

# --- Basis data ---
# Pengembangan lokal memakai Postgres dari docker-compose.yml.
DATABASE_URL="postgresql://demakmuda:demakmuda_dev@localhost:5432/demakmuda?schema=public"

# --- Autentikasi (Better Auth) ---
# Bangkitkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Perlindungan data pribadi ---
# Kunci rahasia untuk menyidik NIK (HMAC). NIK tidak pernah disimpan utuh.
# Bangkitkan dengan perintah yang sama seperti BETTER_AUTH_SECRET.
# Kunci ini TIDAK BOLEH diganti setelah ada data, karena sidik lama menjadi tidak cocok.
NIK_PEPPER=""

# --- Penyimpanan berkas (Vercel Blob) ---
# Pengenal store blob. Bukan rahasia — dipakai mengunci pengoptimal gambar
# ke satu nama inang saja (lihat next.config.ts dan src/lib/blob.ts).
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# --- Mode peragaan ---
# Isi "true" HANYA untuk lingkungan peragaan lomba. Saat aktif, verifikasi
# surel dilewati karena layanan pengiriman surel belum dipasang, dan halaman
# pendaftaran memberi tahu pengunjung bahwa lingkungan itu adalah peragaan.
# Untuk produksi sungguhan: biarkan kosong dan pasang layanan surel lebih dulu.
MODE_PERAGAAN=""

# --- Panduan Karier (MiniMax) ---
# Kunci dari platform.minimax.io. HANYA sisi peladen; tidak pernah dikirim ke peramban.
# Tanpa ini, fitur Panduan Karier menolak dengan pesan yang jelas, bukan galat.
MINIMAX_API_KEY=""

# --- Masuk dengan Google (pilihan) ---
# Dari Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (jenis "Web application"). Daftarkan alamat balik ini pada "Authorized
# redirect URIs", satu untuk tiap lingkungan:
#   http://localhost:3000/api/auth/callback/google
#   https://demakmuda.space/api/auth/callback/google
# Tombol "Lanjutkan dengan Google" hanya tampil bila KEDUA nilai ini terisi.
# Kosongkan keduanya dan aplikasi berjalan seperti biasa tanpa tombol itu.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Saklar fitur ---
# Panduan Karier tampil di menu publik dan di beranda hanya bila diisi "true".
# Kosong atau nilai lain = tersembunyi, dan itu nilai bawaannya.
# Halamannya sendiri tetap hidup pada /pemuda/panduan apa pun nilainya;
# yang disembunyikan jalan masuknya, bukan fiturnya.
FITUR_PANDUAN=""
